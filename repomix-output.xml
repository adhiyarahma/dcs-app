            <div className="flex items-center gap-4 mt-3 pt-3 border-t border-slate-50">
              <div className="text-center">
                <p className="text-base font-bold text-blue-600">
                  {trendDocs
                    .slice(-PERIOD_WINDOW[period])
                    .reduce((a, b) => a + b, 0)
