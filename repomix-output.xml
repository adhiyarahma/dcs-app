                <p className="text-[10px] text-slate-400">
                  Total dok baru {selectedYear}
                </p>
              </div>
              <div className="w-px h-6 bg-slate-100" />
              <div className="text-center">
                <p className="text-base font-bold text-green-500">
                  {(
