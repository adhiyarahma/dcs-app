                  color="#EF9F27"
                  valueLabel={`${d.count}x`}
                />
              ))}
            </div>
          )}
        </div>

        {/* Top departemen penerima distribusi */}
        <div className="bg-white border border-slate-200 rounded-2xl p-5">
          <SectionHeader
            title="Top Penerima Distribusi"
            sub="Departemen penerima dokumen terbanyak"
